<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <!-- Profile Image with Blue Ring for Unread -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp">

        <!-- Blue ring for unread messages (similar to Messenger) -->
        <View
            android:id="@+id/viewUnreadRing"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/blue_ring_background"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Chat Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <!-- Name and User Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvParticipantName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Participant Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvUserType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/student_tag_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Dormitory Name -->
        <TextView
            android:id="@+id/tvDormitoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dormitory Name"
            android:textSize="12sp"
            android:textColor="@color/orange_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Last Message -->
        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last message content..."
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Right Side Info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30"
            android:textSize="12sp"
            android:textColor="@color/gray_text"
            android:layout_marginBottom="8dp" />

        <!-- Unread Count Badge (Messenger-style) -->
        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="3"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/orange_primary"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
