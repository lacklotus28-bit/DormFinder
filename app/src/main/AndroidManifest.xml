<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DormFinder"
        tools:replace="android:fullBackupContent">

        <!-- Add Google Maps API key here -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBEtjXuqlZH8f6P0Ot5x6ez_x1K2WFVgig"/>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />

        <!-- Home Activities -->
        <activity
            android:name=".activities.StudentHomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.LandlordHomeActivity"
            android:exported="false" />

        <!-- Core Feature Activities -->
        <activity
            android:name=".activities.SearchFilterActivity"
            android:exported="false" />

        <activity
            android:name=".activities.DormitoryDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BookingRequestActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddReviewActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AllReviewsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.LandlordReviewsActivity"
            android:exported="false" />

        <!-- Search and Favorites Activities -->
        <activity
            android:name=".activities.FavoritesActivity"
            android:exported="false" />

        <activity
            android:name=".activities.FeaturedDormsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MapActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddDormitoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.LocationPickerActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MyDormitoriesActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AppGuideActivity"
            android:exported="false" />

        <activity
            android:name=".activities.FAQActivity"
            android:exported="false" />

        <!-- Booking System Activities -->
        <activity
            android:name=".activities.BookingManagementActivity"
            android:exported="false" />

        <activity
            android:name=".activities.StudentBookingsActivity"
            android:exported="false" />

        <!-- Messaging System Activities -->
        <activity
            android:name=".activities.ChatListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ChatActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />

        <!-- Payment System Activities -->
        <activity
            android:name=".activities.PaymentActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PaymentHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.LandlordPaymentManagementActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ImageViewActivity"
            android:exported="false" />

        <activity
            android:name=".activities.FullscreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.DormFinder.Fullscreen" />

        <!-- Notification Activity -->
        <activity
            android:name=".activities.NotificationActivity"
            android:exported="false" />

        <!-- Services -->
        <service
            android:name=".services.MessageNotificationService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
