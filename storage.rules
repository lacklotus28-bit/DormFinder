rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to validate image file
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Helper function to check file size (10MB limit)
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    // Profile pictures
    match /profile_images/{userId}/{allPaths=**} {
      // Users can read any profile picture
      allow read: if isAuthenticated();
      
      // Users can only write their own profile pictures
      allow write: if isAuthenticated() && 
                   isOwner(userId) && 
                   isImage() && 
                   isValidSize();
      
      // Users can delete their own profile pictures
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Dormitory images
    match /dormitory_images/{dormId}/{allPaths=**} {
      // Anyone authenticated can read dormitory images
      allow read: if isAuthenticated();
      
      // Only authenticated users can upload dormitory images
      // (We verify ownership in Firestore rules)
      allow write: if isAuthenticated() && 
                   isImage() && 
                   isValidSize();
      
      // Allow deletion by authenticated users
      // (Ownership is checked via Firestore)
      allow delete: if isAuthenticated();
    }
    
    // Chat images/attachments
    match /chat_images/{chatId}/{allPaths=**} {
      // Participants can read chat images
      allow read: if isAuthenticated();
      
      // Participants can upload chat images
      allow write: if isAuthenticated() && 
                   isImage() && 
                   isValidSize();
    }
    
    // Payment receipts
    match /payment_receipts/{paymentId}/{allPaths=**} {
      // Users involved in payment can read receipts
      allow read: if isAuthenticated();
      
      // Users can upload receipts
      allow write: if isAuthenticated() && 
                   isImage() && 
                   isValidSize();
    }
    
    // Temporary uploads (for compression, etc.)
    match /temp/{userId}/{allPaths=**} {
      // Users can only access their own temp files
      allow read, write, delete: if isAuthenticated() && isOwner(userId);
    }
  }
}
