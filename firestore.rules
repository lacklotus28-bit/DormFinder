rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if only rating fields are being updated
    function isRatingUpdate() {
      // Check that only averageRating and totalReviews are being modified
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'totalReviews']);
    }
    
    // Helper function to check if only landlord reply fields are being updated
    function isLandlordReplyUpdate() {
      // Allow updating landlord reply fields
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landlordReply', 'replyDate', 'landlordName', 'hasReply']);
    }
    
    // Users collection - controlled access
    match /users/{userId} {
      // Users can read/write their own document
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Allow authenticated users to read public profile info of other users
      // This is needed for landlord info in dormitory details and chat partners
      allow read: if isAuthenticated();
      
      // ⭐ FIXED: Favorites subcollection under each user
      match /favorites/{favoriteId} {
        // Users can read, write, delete their own favorites
        allow read, write, delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Bookings subcollection under each user (if used)
      match /bookings/{bookingId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Payments subcollection under each user (if used)
      match /payments/{paymentId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Dormitories - landlords can write, everyone can read
    match /dormitories/{dormId} {
      // Anyone authenticated can read dormitories
      allow read: if isAuthenticated();
      
      // Allow creation if user sets themselves as landlord
      allow create: if isAuthenticated() && 
        request.resource.data.landlordId == request.auth.uid;
      
      // Allow landlord to update/delete their dormitory
      allow update, delete: if isAuthenticated() && 
        resource.data.landlordId == request.auth.uid;
      
      // Allow anyone to update ONLY the rating fields (for review system)
      allow update: if isAuthenticated() && isRatingUpdate();
    }
    
    // Reviews collection - FIXED for landlord replies
    match /reviews/{reviewId} {
      // Anyone authenticated can read reviews
      allow read: if isAuthenticated();
      
      // Only authenticated users can create reviews (must match their userId)
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can update or delete their own reviews
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // NEW: Allow landlords to update ONLY landlord reply fields
      // This enables landlords to reply to reviews
      allow update: if isAuthenticated() && isLandlordReplyUpdate();
    }
    
    // Bookings - participants can read/write
    match /bookings/{bookingId} {
      // Allow reading if user is student or landlord in the booking
      allow read: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
      
      // Allow creation by any authenticated user
      allow create: if isAuthenticated();
      
      // Allow updates by participants
      allow update: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
      
      // Allow deletion by student who created it
      allow delete: if isAuthenticated() && 
        resource.data.studentId == request.auth.uid;
    }
    
    // Payments collection - FIXED
    match /payments/{paymentId} {
      // Users can read their own payments (student or landlord)
      allow read: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
      
      // Students can create payments
      allow create: if isAuthenticated() && 
        request.resource.data.studentId == request.auth.uid;
      
      // Students and landlords can update payments (for status updates)
      allow update: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
      
      // Only students can delete their own payments
      allow delete: if isAuthenticated() && 
        resource.data.studentId == request.auth.uid;
    }
    
    // ⭐ FIXED: Chats - participants can read/write/delete
    match /chats/{chatId} {
      // Allow reading if user is participant
      allow read: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
      
      // Allow creation by any authenticated user
      allow create: if isAuthenticated();
      
      // Allow updates by participants
      allow update: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
      
      // ✅ NEW: Allow deletion by participants (for duplicate cleanup)
      allow delete: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid);
         
      // Messages subcollection within chats
      match /messages/{messageId} {
        // Allow reading if user is participant in parent chat
        allow read: if isAuthenticated() && 
          (get(/databases/$(database)/documents/chats/$(chatId)).data.studentId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.landlordId == request.auth.uid);
        
        // Allow creation if user is participant in parent chat
        allow create: if isAuthenticated() && 
          (get(/databases/$(database)/documents/chats/$(chatId)).data.studentId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.landlordId == request.auth.uid);
        
        // ✅ IMPROVED: Allow updates/deletes by any participant (for message management)
        allow update, delete: if isAuthenticated() && 
          (resource.data.senderId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.studentId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.landlordId == request.auth.uid);
      }
    }
    
    // Legacy messages collection (for backward compatibility)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      
      allow create: if isAuthenticated();
      
      allow update, delete: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow creation for system notifications
      allow create: if isAuthenticated();
      
      // Users can update their own notifications (e.g., mark as read)
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // ⚠️ REMOVED: Top-level favorites collection (not used by app)
    // The app uses users/{userId}/favorites/{favoriteId} subcollection instead
  }
}